import socket

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.bind(('localhost', 12345))

print("Server waiting...")

data, addr = s.recvfrom(1024)
msg = data.decode()

result = msg.upper()
s.sendto(result.encode(), addr)

s.close()






import socket

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

