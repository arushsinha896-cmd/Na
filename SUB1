ip = input("Enter the IP Address: ")
octets = ip.split(".")
o1 = int(octets[0])
def get_ip_class(o1):
    if 1 <= o1 <=126:
        return "Class A"
    elif 128 <= o1 <= 191:
        return "Class B"
    elif 192 <= o1 <= 223:
        return "Class C"
    elif 224 <= o1 <= 239:
        return "Class D"
    elif 240 <= o1 <=255:
        return "Class E"
    else:
        return "Invlaid IP Address"
def get_ip_range(o1):
    if 1 <= o1 <=126:
        return "1.0.0.0 - 126.255.255.255"
    elif 128 <= o1 <= 191:
        return "128.0.0.0 - 191.255.255.255"
    elif 192 <= o1 <= 223:
        return "192.0.0.0 - 223.255.255.255"
    elif 224 <= o1 <= 239:
        return "224.0.0.0 - 239.255.255.255"
    elif 240 <= o1 <=255:
        return "240.0.0.0 - 255.255.255.255"
    else:
        return "Invlaid IP Address"
print("The IP Address belongs to: ", get_ip_class(o1))
print("The Range for this IP Address is: ", get_ip_range(o1))
def get_ip_hosts(o1):
    if 1 <= o1 <=126:
        return 2**24 - 2
    elif 128 <= o1 <= 191:
        return 2**16 - 2
    elif 192 <= o1 <= 223:
        return 2**8 - 2
    else:
        return "Not Applicable"
print("The number of hosts for this IP Address are: ", get_ip_hosts(o1))
def get_ip_subnet_masks(o1):
    if 1 <= o1 <=126:
        return "255.0.0.0"
    elif 128 <= o1 <= 191:
        return "255.255.0.0"
    elif 192 <= o1 <= 223:
        return "255.255.255.0"
    else:
        return "Not Applicable"
print("The subnet mask is: ", get_ip_subnet_masks(o1))
