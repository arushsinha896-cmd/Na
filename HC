#include <iostream>
#include <vector>
#include <cmath>
using namespace std;

bool isPowerOfTwo(int x)
{
    return (x && !(x & (x - 1)));
}

int main()
{
    string data;
    cout << "Enter Data Bits: ";
    cin >> data;

    int m = data.length();
    int r = 0;

    while (pow(2, r) < (m + r + 1))
        r++;

    int totalBits = m + r;
    vector<int> hamming(totalBits + 1);

    int j = 0;
    for (int i = 1; i <= totalBits; i++)
    {
        if (isPowerOfTwo(i))
            hamming[i] = 0;
        else
            hamming[i] = data[m - 1 - j++] - '0';
    }

    for (int i = 0; i < r; i++)
    {
        int p = pow(2, i);
        int parity = 0;

        for (int k = 1; k <= totalBits; k++)
        {
            if (k & p)
                parity ^= hamming[k];
        }

        hamming[p] = parity;
    }

    cout << "\n-----TRANSMITTER-----\n";
    cout << "Generated Hamming Code: ";

    for (int i = totalBits; i >= 1; i--)
        cout << hamming[i];

    cout << endl;

    string received;
    cout << "\nEnter received codeword: ";
    cin >> received;

    vector<int> recv(totalBits + 1);

    for (int i = totalBits, idx = 0; i >= 1; i--, idx++)
        recv[i] = received[idx] - '0';

    int errorPos = 0;

    for (int i = 0; i < r; i++)
    {
        int p = pow(2, i);
        int parity = 0;

        for (int k = 1; k <= totalBits; k++)
        {
            if (k & p)
                parity ^= recv[k];
        }

        if (parity)
            errorPos += p;
    }

    cout << "\n-----RECEIVER-----\n";

    if (errorPos == 0)
    {
        cout << "No error detected." << endl;
    }
    else
    {
        cout << "Error detected at bit position: " << errorPos << endl;

        recv[errorPos] ^= 1;

        cout << "Corrected Codeword: ";
        for (int i = totalBits; i >= 1; i--)
            cout << recv[i];
        cout << endl;
    }

    cout << "Recovered Data Bits: ";

    for (int i = totalBits; i >= 1; i--)
    {
        if (!isPowerOfTwo(i))
            cout << recv[i];
    }
    cout << endl;

    return 0;
}
